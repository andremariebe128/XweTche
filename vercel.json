{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/|brand/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/rappels", "schedule": "0 6 * * *" }],
  "functions": { "api/index.ts": { "maxDuration": 30 } }
}
