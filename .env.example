# ===== Base de données (Neon : console.neon.tech > votre projet > « Connect ») =====
# Chaîne POOLÉE (host contenant -pooler) : utilisée par l'API.
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Chaîne DIRECTE (sans -pooler) : utilisée par les migrations (npm run db:migrate).
DATABASE_URL_UNPOOLED=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ===== Sécurité =====
# 32 caractères minimum. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Adresse publique du site (sans / final). En local : http://localhost:5173
APP_URL=http://localhost:5173
# Protège la tâche planifiée /api/cron/rappels
CRON_SECRET=

# ===== Codes SMS (connexion) =====
# demo = le code s'affiche à l'écran, aucun SMS. sms = envoi réel (nécessite un prestataire).
OTP_MODE=demo
# console = affiche le SMS dans le terminal. http = appelle l'API de votre prestataire SMS.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=XweTche

# ===== Paiement Mobile Money =====
# simule = paiement fictif (démo). webhook = confirmation par le prestataire (à brancher).
PAYMENT_MODE=simule
PAYMENT_WEBHOOK_SECRET=

# ===== Photos et pièces (Vercel Blob, store PRIVÉ) — vide en local : dossier .stockage/ =====
BLOB_READ_WRITE_TOKEN=

# Mettre 1 pour autoriser les modes démo en production (déconseillé)
ALLOW_DEMO=
